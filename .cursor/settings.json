{
  "$schema": "https://cursor.sh/schemas/project-settings.json",
  "model": {
    "default": "auto"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(seopartnerhub/**)",
      "Edit(config/**)",
      "Edit(tests/**)",
      "Edit(specs/**)",
      "Edit(.specify/**)",
      "Edit(.cursor/**)",
      "Edit(compose/**)",
      "Edit(frontend/**)",
      "Edit(docker-compose.local.yml)",
      "Edit(docker-compose.docs.yml)",
      "Edit(docker-compose.production.yml)",
      "Edit(README.md)",
      "Edit(readme_start.md)",
      "Edit(readme_spec.md)",
      "Edit(AGENTS.md)",
      "Edit(.gitignore)",
      "Edit(.dockerignore)",
      "Edit(manage.py)",
      "Shell(git status)",
      "Shell(git diff*)",
      "Shell(git log*)",
      "Shell(git show*)",
      "Shell(uv run *)",
      "Shell(docker compose *)",
      "Shell(pnpm *)",
      "Shell(npx *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production*)",
      "Read(.envs/**)",
      "Read(frontend/**/.env)",
      "Read(frontend/**/.env.local)",
      "Read(frontend/**/.env.production*)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production*)",
      "Edit(.envs/**)",
      "Edit(frontend/**/.env.production*)"
    ]
  },
  "hooks": ".cursor/hooks.json"
}
