# -----------------------------------------------------------------------------
# Test/demo env for frontend/full-version (Vuexy showcase).
#
# full-version is a backend-free component donor for SEOPartnerHub. The
# bundled NextAuth + Prisma demo needs these vars to boot; all values are
# fake or point at in-repo mock routes.
#
# Credentials sign-in works with the bundled Vuexy mock
# (admin@vuexy.com / admin). Google OAuth button is shown but fails cleanly
# because the OAuth client id is fake.
#
# Do NOT point any of these at Django; full-version must stay isolated from
# the product backend.
#
# Usage:
#   cp .env.example .env.local
# Next.js auto-loads `.env.local` (gitignored) on dev/build.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
BASEPATH=
NEXT_PUBLIC_APP_URL=http://localhost:3001${BASEPATH}
NEXT_PUBLIC_DOCS_URL=https://demos.pixinvent.com/vuexy-nextjs-admin-template/documentation

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
NEXTAUTH_BASEPATH=${BASEPATH}/api/auth
NEXTAUTH_URL=http://localhost:3001${BASEPATH}/api/auth
NEXTAUTH_SECRET=demo-only-not-a-real-secret-replace-in-production

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
# Fake values; the Google sign-in button stays clickable but fails cleanly.
GOOGLE_CLIENT_ID=demo-google-client-id
GOOGLE_CLIENT_SECRET=demo-google-client-secret

# -----------------------------------------------------------------------------
# Database (Prisma; SQLite by default for the demo)
# -----------------------------------------------------------------------------
DATABASE_URL=file:./dev.db

# -----------------------------------------------------------------------------
# API
# Points at the in-repo Vuexy mock route (src/app/api/login/route.ts) so the
# bundled credentials login works with demo creds: admin@vuexy.com / admin.
# IMPORTANT: MUST NOT point to Django. full-version is backend-free.
# -----------------------------------------------------------------------------
API_URL=http://localhost:3001${BASEPATH}/api
NEXT_PUBLIC_API_URL=${API_URL}

# -----------------------------------------------------------------------------
# Mapbox (showcase map pages). Empty = map pages render without tiles.
# -----------------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN=
